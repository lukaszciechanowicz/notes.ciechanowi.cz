---
interface Props { current?: 'notes' | 'about' | 'gallery' }
const { current } = Astro.props;
---
<header class="site-header">
  <nav class="site-nav" aria-label="Main">
    <a href="/" aria-current={current === 'notes' ? 'page' : undefined}>Notes</a>
    <a href="/about/" aria-current={current === 'about' ? 'page' : undefined}>About</a>
    <a href="/gallery/" aria-current={current === 'gallery' ? 'page' : undefined}>GoT</a>
    <a href="https://www.linkedin.com/in/lukaszciechanowicz">Linkedin</a>
  </nav>
  <button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Light theme" data-theme-toggle hidden>
    <svg class="theme-bulb" viewBox="0 0 64 64" fill="none" aria-hidden="true">
      <path class="bulb-light" d="M23 44C23 37 15 35 15 25C15 15 23 9 32 10C43 10 49 17 48 27C47 35 40 38 40 44Z" fill="currentColor" opacity=".13" />
      <g stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
        <path d="M23 43C23 37 15 35 15 25C15 15 23 9 32 10C43 10 49 17 48 27C47 35 40 38 40 43M24 46L39 46M24 50L38 50M27 54C30 57 35 57 38 53" />
        <path d="M28 43L26 29L32 33L37 28L35 43" stroke-width="1.15" />
        <path d="M19 24C19 17 24 14 28 14" stroke-width=".8" opacity=".35" />
        <path class="bulb-light" d="M32 2L32 5M12 8L16 12M4 25L9 25M54 25L60 25M49 9L53 5M53 41L58 45M8 44L13 40" stroke-width="1.3" />
      </g>
    </svg>
    <span class="sr-only" data-theme-label>Turn on the light theme</span>
  </button>
</header>
